---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <Fragment slot="head">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IEL | Resources</title>
    <meta
      name="description"
      content="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
    />

    <meta
      property="og:title"
      content="Resources | Integrated Equities Limited (IEL)"
    />
    <meta
      property="og:description"
      content="Access IEL's resources covering sector analysis, market insights, and investment intelligence for Pakistan's capital markets."
    />
    <meta property="og:url" content="https://iel.net.pk/Resources.html" />
    <meta
      property="og:image"
      content="https://iel.net.pk/Assets/whiteLogoSvg.svg"
    />
     <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Integrated Equities Limited" />
    <link rel="canonical" href="https://iel.net.pk/Resources.html" />


    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="Assets/finalNavbar/navbar.css" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <style is:inline>
      #typed-text span {
        display: block;
      }
      .footer {
        /* Matches the height of the first div to create overlap */
        background: linear-gradient(180deg, #0f0d17 0%, #191535 100%);
      }
      .bg-overlay {
        position: relative;
        z-index: 10;
        top: -150px;
      }
    </style>
  
  </Fragment>

    <!-------------------------Hero Section------------------------->
    <div>
      <main class="h-[300px] xl:h-[338px]">
        <div class="content h-[338px] xl:h-[338px]">
          <div class="relative w-[100vw] h-[338px]">
            <div class="container mx-auto">
              <div
                class="absolute top-0 left-0 w-full h-full object-cover hidden xl:block"
                style="
                  background: linear-gradient(
                    93.15deg,
                    #0e0c15 0%,
                    #1a1538 100%
                  );
                "
              ></div>
              <div
                class="absolute top-0 left-0 w-full h-full object-cover bg-[#F9F9F9] block xl:hidden"
              ></div>
              <div
                class="relative flex flex-col-reverse xl:flex-row py-[40px] xl:py-[60px] px-[24px] xl:px-[42px] lg:px-16 justify-center md:justify-between item-center mt-[10vh] md:mt-[10vh] 3xl:mt-[10vh]"
              >
                <div
                  class="relative text-black xl:text-white w-full flex flex-col justify-center items-center"
                  style="z-index: 105"
                >
                  <h1
                    id="typed-text"
                    class="font-[600] text-[28px] xl:text-[40px] xl:text-[40px] 2xl:text-[40px] leading-[100%] mt-[20px]"
                  >
                    Resources
                  </h1>
                  <p
                    class="font-[400] text-[16px] leading-[24px] mt-[12px] text-center"
                  >
                    Your investment toolkit, simplified. From beginner guides to
                    market analysis — find what you need, when you need it.
                  </p>
                </div>
                <img
                  src="IEL Assets/new_header_pattern.png"
                  alt="Header Pattern"
                  class="h-[200px] w-[580px] absolute -right-[100px] hidden xl:block"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
