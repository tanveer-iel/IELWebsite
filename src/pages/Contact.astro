<script is:inline>
      const formInputs = {
        name: document.getElementById("name"),
        email: document.getElementById("email"),
        subject: document.getElementById("subject"),
        comments: document.getElementById("comments"),
      };
      const submitBtn = document.getElementById("submit-btn");
      const successMessage = document.getElementById("success-message");
      const errorSubmit = document.getElementById("error-submit");

      function validateForm() {
        const errors = {};
        if (!formInputs.name.value.trim()) {
          errors.name = "Name is required";
          formInputs.name.classList.add("error");
          document.getElementById("name-error").textContent = errors.name;
        } else {
          formInputs.name.classList.remove("error");
          document.getElementById("name-error").textContent = "";
        }

        if (!formInputs.email.value.trim()) {
          errors.email = "Email is required";
          formInputs.email.classList.add("error");
          document.getElementById("email-error").textContent = errors.email;
        } else if (!/\S+@\S+\.\S+/.test(formInputs.email.value)) {
          errors.email = "Valid email is required";
          formInputs.email.classList.add("error");
          document.getElementById("email-error").textContent = errors.email;
        } else {
          formInputs.email.classList.remove("error");
          document.getElementById("email-error").textContent = "";
        }

        if (!formInputs.subject.value.trim()) {
          errors.subject = "Subject is required";
          formInputs.subject.classList.add("error");
          document.getElementById("subject-error").textContent = errors.subject;
        } else {
          formInputs.subject.classList.remove("error");
          document.getElementById("subject-error").textContent = "";
        }

        if (!formInputs.comments.value.trim()) {
          errors.comments = "Comments are required";
          formInputs.comments.classList.add("error");
          document.getElementById("comments-error").textContent =
            errors.comments;
        } else {
          formInputs.comments.classList.remove("error");
          document.getElementById("comments-error").textContent = "";
        }

        return errors;
      }

      submitBtn.addEventListener("click", async () => {
        const errors = validateForm();
        if (Object.keys(errors).length > 0) return;

        const formData = {
          name: formInputs.name.value,
          email: formInputs.email.value,
          subject: formInputs.subject.value,
          comments: formInputs.comments.value,
        };

        try {
          const response = await fetch(
            "https://ielapis.u2ventures.io/api/contact/contactus/",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(formData),
            }
          );

          if (!response.ok) {
            throw new Error("Failed to submit form");
          }

          successMessage.textContent = "Form submitted successfully!";
          errorSubmit.textContent = "";
          formInputs.name.value = "";
          formInputs.email.value = "";
          formInputs.subject.value = "";
          formInputs.comments.value = "";
          setTimeout(() => (successMessage.textContent = ""), 20000);
        } catch (error) {
          errorSubmit.textContent = "Failed to submit form. Please try again.";
          successMessage.textContent = "";
          console.error("Error submitting form:", error);
          setTimeout(() => (errorSubmit.textContent = ""), 3000);
        }
      });

      // Clear error messages when user starts typing
      Object.values(formInputs).forEach((input) => {
        input.addEventListener("input", () => {
          input.classList.remove("error");
          document.getElementById(`${input.id}-error`).textContent = "";
        });
      });
      function switchTab(tab) {
        // Remove active class from all buttons
        document.querySelectorAll("button[data-tab]").forEach((btn) => {
          btn.classList.remove("bg-[#E3432D]", "text-white");
          btn.classList.add("text-black");
        });

        // Add active class to selected button
        document
          .querySelector(`button[data-tab="${tab}"]`)
          .classList.add("bg-[#E3432D]", "text-white");
        document
          .querySelector(`button[data-tab="${tab}"]`)
          .classList.remove("text-black");

        // Hide all maps
        document.querySelectorAll(".map-content").forEach((map) => {
          map.classList.add("hidden");
          map.classList.remove("active-map");
        });

        // Show selected map
        document.getElementById(`${tab}-map`).classList.remove("hidden");
        document.getElementById(`${tab}-map`).classList.add("active-map");
      }
    </script>

    <script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"
