      }
      .form_Section {
        position: relative;
        z-index: 10;
        top: -120px;
      }
      @media screen and (max-width: 1270px) {
        .form_Section {
          top: 0px;
        }
      }

      .error {
        border-color: #ff0000 !important;
      }
      .error-message {
        color: #ff0000;
        font-size: 14px;
        margin-top: 4px;
      }
      .success-message {
        color: #008000;
        font-size: 14px;
        margin-top: 8px;
      }
      .error-submit {
        color: #ff0000;
        font-size: 14px;
        margin-top: 8px;
