---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <Fragment slot="head">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IEL | Research</title>
    <meta
      name="description"
      content="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
    />

    <meta
      property="og:title"
      content="Research | Integrated Equities Limited (IEL)"
    />
    <meta
      property="og:description"
      content="Access IEL's research reports covering sector analysis, market insights, and investment intelligence for Pakistan's capital markets."
    />
    <meta property="og:url" content="https://iel.net.pk/Research.html" />

    <meta
      property="og:image"
      content="https://iel.net.pk/Assets/whiteLogoSvg.svg"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Integrated Equities Limited" />
    <link rel="canonical" href="https://iel.net.pk/Research.html" />

    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="Assets/finalNavbar/navbar.css" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <style is:inline>
      #typed-text span {
        display: block;
      }
      .footer {
        /* Matches the height of the first div to create overlap */
        background: linear-gradient(180deg, #0f0d17 0%, #191535 100%);
      }
      .bg-overlay {
        position: relative;
        z-index: 10;
        top: -150px;
      }

      @keyframes ticker {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
      .ticker-track {
        animation: ticker 35s linear infinite;
      }
      .ticker-wrap:hover .ticker-track {
        animation-play-state: paused;
      }
      @media (prefers-reduced-motion: reduce) {
        .ticker-track {
          animation: none;
        }
      }
    </style>
  
  </Fragment>

    <!-------------------------Hero Section------------------------->
    <div>
      <main class="h-[438px] md:h-[438px]">
        <div class="content h-[438px] md:h-[438px]">
          <div class="relative w-[100vw] h-[438px]">
            <div class="container mx-auto">
              <div
                class="absolute top-0 left-0 w-full h-full object-cover hidden md:block"
                style="
                  background: linear-gradient(
                    93.15deg,
                    #0e0c15 0%,
                    #1a1538 100%
                  );
                "
              ></div>
              <div
                class="absolute top-0 left-0 w-full h-full object-cover bg-[#F9F9F9] block md:hidden"
              ></div>
              <div
                class="relative flex flex-col-reverse md:flex-row py-[40px] md:py-[60px] px-[24px] md:px-[42px] lg:px-16 justify-center md:justify-between item-center mt-[10vh] md:mt-[10vh] 3xl:mt-[10vh]"
              >
                <div
                  class="relative text-center md:text-start text-black md:text-white w-full flex flex-col justify-center items-center"
                  style="z-index: 105"
                >
                  <h1
                    id="typed-text"
                    class="font-[600] text-[30px] md:text-[40px] xl:text-[40px] 2xl:text-[40px] leading-[100%] mt-[20px]"
                  >
                    Research
                  </h1>
                  <p
                    class="font-[400] text-[16px] leading-[24px] mt-[12px] text-center"
                  >
                    Smarter research. Sharper execution.
                  </p>

                  <p
                    class="font-[400] text-[16px] leading-[24px] mt-[12px] text-center"
                  >
                    Economic, Market, Sector, and Company-level research
                    insights — all at one click
                  </p>

                  <form
                    id="searchForm"
                    class="flex w-full max-w-xl items-center gap-3 mt-[20px]"
                    role="search"
                    onsubmit="event.preventDefault()"
                  >
                    <label for="searchInput" class="sr-only"
                      >Search reports</label
                    >
                    <input
                      id="searchInput"
                      type="search"
                      placeholder="Search reports — try “fertilizer” or “FFC”"
                      class="h-11 min-w-0 flex-1 rounded-md border border-gray-300 bg-white px-4 text-sm text-gray-900 placeholder-gray-400 focus:border-[#e8452c] focus:outline-none focus:ring-2 focus:ring-[#e8452c]/30"
                    />
                    <button
                      type="submit"
                      class="h-11 shrink-0 rounded-md bg-[#e8452c] px-8 text-sm font-semibold text-white transition hover:bg-[#d23b24] focus:outline-none focus:ring-2 focus:ring-[#e8452c] focus:ring-offset-2"
                    >
                      Search
                    </button>
                  </form>
                </div>
                <img
                  src="IEL Assets/new_header_pattern.png"
                  alt="Header Pattern"
                  class="h-[200px] w-[580px] absolute -right-[100px] hidden md:block"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="menu h-[80px] pt-[10px] bg-white">
          <Nav />
        </div>
      </main>
    </div>

    <!-- -----------------News Section---------------------- -->
    <section aria-label="Today's news" class="mt-4 bg-[#0f0e24]">
      <div class="flex items-stretch">
        <!-- Label -->
        <div
          class="flex shrink-0 items-center bg-[#e8452c] px-5 py-3.5 sm:px-6"
        >
          <span
            class="text-xs font-bold uppercase tracking-wide text-white sm:text-sm"
            >Today's News</span
          >
        </div>

        <!-- Items -->
        <div class="ticker-wrap flex-1 overflow-hidden">
          <ul
            id="ticker-track"
            class="ticker-track flex w-max items-center whitespace-nowrap py-3.5 pl-5"
          >
            <li class="flex shrink-0 items-center gap-3 pr-10">
              <span
                class="rounded-full bg-[#e8452c] px-3 py-1 text-[10px] font-bold uppercase text-white"
                >Business Recorder</span
              >
              <a href="#" class="text-sm text-white hover:underline"
                >Rupee steady against dollar in interbank trade</a
              >
            </li>
            <li class="flex shrink-0 items-center gap-3 pr-10">
              <span
                class="rounded-full bg-[#1f5a3d] px-3 py-1 text-[10px] font-bold uppercase text-white"
                >Express Tribune</span
              >
              <a href="#" class="text-sm text-white hover:underline"
                >SBP reserves rise on inflows, external account improves</a
              >
            </li>
            <li class="flex shrink-0 items-center gap-3 pr-10">
              <span
                class="rounded-full bg-[#e8452c] px-3 py-1 text-[10px] font-bold uppercase text-white"
                >Business Recorder</span
              >
              <a href="#" class="text-sm text-white hover:underline"
                >PSX benchmark index extends gains on bargain hunting</a
              >
            </li>
            <li class="flex shrink-0 items-center gap-3 pr-10">
              <span
                class="rounded-full bg-[#1f5a3d] px-3 py-1 text-[10px] font-bold uppercase text-white"
                >Express Tribune</span
              >
              <a href="#" class="text-sm text-white hover:underline"
                >Textile exports edge higher as new orders pick up</a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!------------------------- Tab Section ------------------------->
    <div class="mt-[60px] md:mt-[80px] mx-[7vw]">
      <h2 class="text-[28px] md:text-[40px] font-[700] text-[#000000E5]">
        Research Reports
      </h2>

      <!-- Tabs -->
      <div class="mt-8 border-b border-gray-200 overflow-x-auto">
        <div id="categoryTabs" class="flex gap-8 min-w-max">
          <button data-tab="Economic" class="tab-btn">Economic</button>
          <button data-tab="Market" class="tab-btn">Market</button>
          <button data-tab="Sector" class="tab-btn">Sector</button>
          <button data-tab="Company" class="tab-btn">Company</button>
          <button data-tab="Technical" class="tab-btn">Technical</button>
        </div>
      </div>

      <!-- Filter pills + sector dropdown (dropdown only shows on Sector tab) -->
      <div
        class="mt-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
      >
        <div id="freqPills" class="flex flex-wrap gap-2">
          <button data-freq="All" class="pill-btn">All</button>
          <button data-freq="Daily" class="pill-btn">Daily</button>
          <button data-freq="Weekly" class="pill-btn">Weekly</button>
          <button data-freq="Market-wide" class="pill-btn">Market-wide</button>
        </div>

        <div id="sectorWrap" class="relative w-full md:w-[280px] hidden">
          <select
            id="sectorDropdown"
            class="appearance-none w-full bg-white border border-gray-200 rounded-full px-5 py-2.5 pr-10 text-[14px] font-[600] text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-300 cursor-pointer"
          >
            <option value="">All Sectors</option>
          </select>
          <div
            class="absolute inset-y-0 right-4 flex items-center pointer-events-none"
          >
            <svg
              class="w-4 h-4 text-gray-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </div>
        </div>
      </div>

      <!-- List + Trending -->
      <div
        class="mt-6 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-6 items-start"
      >
        <div id="researchContainer" class="flex flex-col gap-4">
          <p class="text-gray-500 text-center py-10">Loading...</p>
        </div>

        <aside class="rounded-2xl border border-gray-200 bg-white p-5">
          <h3
            class="text-[13px] font-[700] tracking-wide text-[#000000E5] uppercase"
          >
            Trending this week
          </h3>
          <ol id="trendingList" class="mt-4"></ol>
        </aside>
      </div>
    </div>

    <!-- ---------------------CTA Section----------------- -->
    <div class="mt-[60px] md:mt-[80px] mx-[7vw]">
      <div
        class="mx-auto flex flex-col gap-4 rounded-xl bg-gradient-to-b from-[#0d0d14] to-[#1b1a35] px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      >
        <!-- Text -->
        <div>
          <h2 class="text-base font-bold text-white">
            Subscribe to our premium research reports
          </h2>
          <p class="mt-1 text-xs text-gray-300">
            Share your email address here and click Subscribe.
          </p>
        </div>

        <!-- Form -->
        <form
          class="flex w-full items-center gap-3 sm:w-auto"
          onsubmit="event.preventDefault()"
        >
          <label for="email" class="sr-only">Email address</label>
          <input
            id="email"
            type="email"
            placeholder="you@email.com"
            required
            class="h-9 w-full rounded-md border-0 bg-white px-3 text-xs text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 sm:w-44 md:w-56"
          />
          <button
            type="submit"
            class="h-9 shrink-0 rounded-md bg-[#4cb782] px-5 text-xs font-medium text-white transition hover:bg-[#3fa573] focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-[#14142a]"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
    <!-------------------------Footer---------------------->

    <Footer extra="mt-[80px]" />
<script is:inline>
      // Tabs
      const tabs = document.querySelectorAll(".tab-button");
      const contents = document.querySelectorAll(".team-content");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => {
            t.classList.remove("active_tab");
            t.classList.add("account_button");
            t.style.background = "";
            t.style.border = "";
          });
          tab.classList.add("active_tab");
          tab.classList.remove("account_button");
          tab.style.background =
            "linear-gradient(180deg, #f4f4f4 0%, #fefefe 100%)";
          tab.style.border = "4px solid #ECECEC";
          contents.forEach((content) => content.classList.add("hidden"));

          // Show the corresponding content
          const contentId = tab.id.replace("-tab", "-content");
          document.getElementById(contentId).classList.remove("hidden");
        });
      });
    </script>
    <script is:inline>
      // Duplicate the items once so the marquee loops seamlessly
      const track = document.getElementById("ticker-track");
      [...track.children].forEach((li) => {
        const clone = li.cloneNode(true);
        clone.setAttribute("aria-hidden", "true");
        track.appendChild(clone);
      });
    </script>
    <script is:inline
      src="https://code.jquery.com/jquery-3.7.1.min.js"
      integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
      crossorigin="anonymous"
    ></script>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="supabaseReseach.js"></script>
    <script is:inline src="index.js"></script>
  
</Layout>
