  <script is:inline src="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.min.js"></script>

  <!-- Supabase + Dynamic Loading -->
  <script is:inline>
  const supabaseUrl = "https://bfxmfaakufrmzcxhtgfw.supabase.co";
const supabaseKey =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJmeG1mYWFrdWZybXpjeGh0Z2Z3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk4MTQzMTIsImV4cCI6MjA3NTM5MDMxMn0.qtNn0qXNhn8ol8fTSb2Hp9nQkYfFA2Y_Zec4LuISPZQ";

let supabaseClient = null;

function initSupabase() {
  if (typeof supabase === "undefined") {
    console.warn("supabase global not ready yet, waiting...");
    setTimeout(initSupabase, 100);
    return;
  }

  const { createClient } = supabase;
  supabaseClient = createClient(supabaseUrl, supabaseKey);
  console.log("Supabase client initialized!", supabaseClient);
}

initSupabase();

    const urlParams = new URLSearchParams(window.location.search);
    const blogId = urlParams.get("id");

    async function loadBlogDetail() {
      if (!blogId) {
        document.getElementById("loading").style.display = "none";
        document.getElementById("error").classList.remove("hidden");
        return;
      }

      const loading = document.getElementById("loading");
      const errorEl = document.getElementById("error");
      const detail  = document.getElementById("blog-detail");

      try {
        const { data: blog, error } = await supabaseClient
          .from("blogs")
          .select("title, img, desc, created_at")
          .eq("id", blogId)
          .single();

        if (error || !blog) throw error;

        // Hero image
        const heroImg = document.getElementById("blog-hero");
        heroImg.src = blog.img || "https://via.placeholder.com/1400x400?text=No+Image";
        heroImg.alt = blog.title || "Blog image";
        heroImg.onerror = () => {
          heroImg.src = "https://via.placeholder.com/1400x400?text=Image+Error";
        };

        // Title
        document.getElementById("blog-title").textContent = blog.title || "Untitled";

        // Body (supports HTML from rich text editor)
        document.getElementById("blog-body").innerHTML = blog.desc || "<p>No content available.</p>";

        // Date
        if (blog.created_at) {
          const date = new Date(blog.created_at);
          // If you want to show date → add element with id="blog-date"
          // document.getElementById("blog-date").textContent = date.toLocaleDateString("en-US", {
          //   year: "numeric", month: "long", day: "numeric"
          // });
        }

        loading.style.display = "none";
        detail.classList.remove("hidden");

        document.title = `${blog.title} - IEL Blog`;

      } catch (err) {
        console.error(err);
        loading.style.display = "none";
        errorEl.classList.remove("hidden");
      }
    }

    loadBlogDetail();
  </script>

   <script is:inline src="index.js"></script>

</Layout>
