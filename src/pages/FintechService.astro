    <Footer extra="mt-[80px]" />
<script is:inline>
      // Tabs
      const tabs = document.querySelectorAll(".tab-button");
      const contents = document.querySelectorAll(".team-content");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => {
            t.classList.remove("active_tab");
            t.classList.add("account_button");
            t.style.background = "";
            t.style.border = "";
          });
          tab.classList.add("active_tab");
          tab.classList.remove("account_button");
          tab.style.background =
            "linear-gradient(180deg, #f4f4f4 0%, #fefefe 100%)";
          tab.style.border = "4px solid #ECECEC";
          contents.forEach((content) => content.classList.add("hidden"));

          // Show the corresponding content
          const contentId = tab.id.replace("-tab", "-content");
          document.getElementById(contentId).classList.remove("hidden");
        });
      });

      //  faqs
      document.querySelectorAll(".faq-question").forEach((button) => {
        button.addEventListener("click", () => {
          const answer = button.nextElementSibling;
          const toggle = button.querySelector(".faq-toggle");

          // Toggle the answer visibility
          answer.classList.toggle("hidden");

          // Update toggle icon
          toggle.innerHTML = answer.classList.contains("hidden")
            ? '<img src="IEL Assets/faq_plus_icon.png" alt="Expand" loading="lazy" style="width: 24px; height: 24px;">'
            : '<img src="IEL Assets/faq_minus_icon.png" alt="Collapse" loading="lazy" style="width: 24px; height: 24px;">';

          // Close other open FAQs
          document.querySelectorAll(".faq-answer").forEach((otherAnswer) => {
            if (
              otherAnswer !== answer &&
              !otherAnswer.classList.contains("hidden")
            ) {
              otherAnswer.classList.add("hidden");
              otherAnswer.previousElementSibling.querySelector(
                ".faq-toggle"
              ).textContent = "+";
            }
          });
        });
      });
    </script>
