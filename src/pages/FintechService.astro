---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <Fragment slot="head">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IEL | Fintech & Digital Solutions</title>
  <meta
      name="description"
      content="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
    />


    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Fintech & Digital Solutions | Integrated Equities Limited (IEL)"
    />
    <meta
      property="og:description"
      content="Expert Fintech & Digital Solutions services to help you navigate the complexities of the financial markets and achieve your goals."
    />
    <meta
      property="og:url"
      content="https://iel.net.pk/FintechService.html"
    />
    <meta
      property="og:image"
      content="https://iel.net.pk/Assets/whiteLogoSvg.svg"
    />
    <meta property="og:site_name" content="Integrated Equities Limited" />
    <link rel="canonical" href="https://iel.net.pk/FintechService.html" />


    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="Assets/finalNavbar/navbar.css" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Slick CSS -->
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick-theme.css"
    />
    <style is:inline>
      #typed-text span {
        display: block;
      }
      .footer {
        /* Matches the height of the first div to create overlap */
        background: linear-gradient(180deg, #0f0d17 0%, #191535 100%);
      }
      .bg-overlay {
        position: relative;
        z-index: 10;
        top: -150px;
      }
    </style>
  
  </Fragment>

    <!-------------------------Hero Section------------------------->
    <div>
      <main class="h-[338px] xl:h-[338px]">
        <div class="content h-[338px] xl:h-[338px]">
          <div class="relative w-[100vw] h-[338px]">
            <div class="container mx-auto">
              <div
                class="absolute top-0 left-0 w-full h-full object-cover hidden xl:block"
                style="
                  background: linear-gradient(
                    93.15deg,
                    #0e0c15 0%,
                    #1a1538 100%
                  );
                "
              ></div>
              <div
                class="absolute top-0 left-0 w-full h-full object-cover bg-[#F9F9F9] block xl:hidden"
              ></div>
              <div
                class="relative flex flex-col-reverse xl:flex-row py-[40px] xl:py-[60px] px-[24px] xl:px-[42px] lg:px-16 justify-center md:justify-between item-center mt-[10vh] md:mt-[10vh] 3xl:mt-[10vh]"
              >
                <div
                  class="relative text-center xl:text-start text-black xl:text-white w-full flex flex-col justify-center items-center"
                  style="z-index: 105"
                >
                  <h1
                    id="typed-text"
                    class="font-[600] text-[28px] xl:text-[40px] xl:text-[40px] 2xl:text-[40px] leading-[100%] mt-[20px]"
                  >
                    Fintech & Digital Solutions
                  </h1>
                  <p class="font-[400] text-[16px] leading-[24px] mt-[12px]">
                    Fintech that works—making finance intuitive for your clients
                    and scalable for you.
                  </p>
                </div>
                <img
                  src="IEL Assets/new_header_pattern.png"
                  alt="Header Pattern"
                  class="h-[200px] w-[580px] absolute -right-[100px] hidden xl:block"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>

       <div
          class="menu h-[80px] pt-[10px] bg-white"
        >
          <Nav />
        </div>
      </main>
    </div>
    <!-- -------Trading doesn't have to be complicated.---------------- -->
    <div
      class="md:mt-[64px] py-[40px] px-[16px] md:px-[7vw]"
      style="
        background: linear-gradient(117.25deg, #edf3ff 22.16%, #ffffff 89.64%);
      "
    >
      <div
        class="w-full max-w-[1400px] mx-auto flex flex-col-reverse md:flex-row justify-between items-center"
      >
        <div class="mt-[24px] md:mt-0">
          <img
            src="IEL Assets/Fintech_service_img.png"
            alt="Fintech Service"
            class="w-auto md:w-[500px] h-[372px]"
            loading="lazy"
          />
        </div>
        <div class="w-full md:w-[620px] text-center md:text-start">
          <h2
            class="text-[#000000] text-[20px] md:text-[40px] font-[600] leading-[100%]"
          >
            Trading doesn't have to be complicated.
          </h2>
          <p
            class="mt-[12px] text-[#6E6E6E] font-[500] text-[16px] md:text-[20px] leading-[120%] md:leading-[28px]"
          >
            We built a platform that actually makes sense. Clean charts, real
            insights, zero fluff. Because your money deserves better than
            guesswork.
          </p>

          <div
            class="flex justify-center md:justify-start items-center mt-[32px]"
          >
            <a
              class="py-3 flex justify-center items-center rounded-[4px] bg-[#E3442D] text-white font-[600] text-[16px] w-[263px]"
              href="OpenAccount.html"
            >
              Start Trading
            </a>
          </div>
        </div>
      </div>
    </div>
    <!-- ------------------------------Cards Section---------------- -->

    <div class="mt-[28px] md:mt-[80px] mx-[16px] md:mx-[7vw]">
      <h2
        class="text-[#000000] font-[600] text-[20px] md:text-[40px] leading-[100%] mb-[24px] md:mb-[48px] text-center"
      >
        Get to know more about this.
      </h2>
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-[16px] md:gap-[40px] w-full max-w-[1400px] mx-auto"
      >
        <div
          class="bg-[#FFFFFF] border border-[#D8D9D880] py-[24px] px-[20px] rounded-[8px] xl:h-[270px]"
          style="box-shadow: 0px 8px 16px 0px #0000000f"
        >
          <img
            src="IEL Assets/service_icon_1.png"
            alt="Service 1"
            class="w-[80px] h-[80px]"
            loading="lazy"
          />

          <div
            class="text-[#000000] font-[500] text-[16px] md:text-[24px] leading-[100%] mt-[12px]"
          >
            White-label Brokerage Apps
          </div>
          <p
            class="mt-[12px] font-[400] text-[14px] md:text-[16px] leading-[100%] text-[#6E6E6E]"
          >
            Your brand, our technology. Complete mobile and web trading
            platforms that you can customize and launch under your own
            identity—no development headaches required.
          </p>
          <hr class="mt-[32px] border-[#EA5B29] border-1" />
        </div>

        <div
          class="bg-[#FFFFFF] border border-[#D8D9D880] py-[24px] px-[20px] rounded-[8px] xl:h-[270px]"
          style="box-shadow: 0px 8px 16px 0px #0000000f"
        >
          <img
            src="IEL Assets/service_icon_2.png"
            alt="Service 2"
            class="w-[80px] h-[80px]"
            loading="lazy"
          />

          <div
            class="text-[#000000] font-[500] text-[16px] md:text-[24px] leading-[100%] mt-[12px]"
          >
            AI-powered Investment Insights
          </div>
          <p
            class="mt-[12px] font-[400] text-[14px] md:text-[16px] leading-[100%] text-[#6E6E6E]"
          >
            Why guess when you can know? Smart analytics powered by artificial
            intelligence spot patterns, predict trends, and deliver insights
            that make sense to everyone.
          </p>
          <hr class="mt-[32px] border-[#EA5B29] border-1" />
        </div>

        <div
          class="bg-[#FFFFFF] border border-[#D8D9D880] py-[24px] px-[20px] rounded-[8px] xl:h-[270px]"
          style="box-shadow: 0px 8px 16px 0px #0000000f"
        >
          <img
            src="IEL Assets/service_icon_3.png"
            alt="Service 3"
            class="w-[80px] h-[80px]"
          loading="lazy"
            />

          <div
            class="text-[#000000] font-[500] text-[16px] md:text-[24px] leading-[100%] mt-[12px]"
          >
            API-based Trading Infrastructure
          </div>
          <p
            class="mt-[12px] font-[400] text-[14px] md:text-[16px] leading-[100%] text-[#6E6E6E]"
          >
            Seamless connectivity meets enterprise reliability—our robust API
            infrastructure links your systems to trading platforms, market data,
            and financial services effortlessly.
          </p>
          <hr class="mt-[32px] border-[#EA5B29] border-1" />
        </div>

        <div
          class="bg-[#FFFFFF] border border-[#D8D9D880] py-[24px] px-[20px] rounded-[8px] xl:h-[270px]"
          style="box-shadow: 0px 8px 16px 0px #0000000f"
        >
          <img
            src="IEL Assets/service_icon_4.png"
            alt="Service 4"
            class="w-[80px] h-[80px]"
            loading="lazy"
          />

          <div
            class="text-[#000000] font-[500] text-[16px] md:text-[24px] leading-[100%] mt-[12px]"
          >
            Investor Education Platforms
          </div>
          <p
            class="mt-[12px] font-[400] text-[14px] md:text-[16px] leading-[100%] text-[#6E6E6E]"
          >
            Transform confusion into confidence through interactive learning
            tools that turn the most complex financial concepts into clear,
            actionable knowledge.
          </p>
          <hr class="mt-[32px] border-[#EA5B29] border-1" />
        </div>
      </div>
    </div>

    <!-- ------------------------------partner--------------------- -->
    <div class="mt-[28px] md:mt-[80px]">
      <h2
        class="text-[28px] md:text-[40px] font-[700] leading-[100%] text-center px-[10px] xl:px-0"
      >
        Who we have worked with:
      </h2>

      <div
        class="partner_carousel flex flex-wrap justify-center items-center gap-6 py-[32px] md:py-[48px]"
      >
        <div class="w-36 h-36">
          <img
            src="IEL Assets/partners/logo_1.png"
            alt="Partner 1"
            class="object-contain h-full w-full"
            loading="lazy"
          />
        </div>
        <div class="w-36 h-36">
          <img
            src="IEL Assets/partners/logo_2.png"
            alt="Partner 2"
            class="object-contain h-full w-full"
            loading="lazy"
          />
        </div>
        <div class="w-36 h-36">
          <img
            src="IEL Assets/partners/logo_3.png"
            alt="Partner 3"
            class="object-contain h-full w-full"
            loading="lazy"
          />
        </div>
        <div class="w-36 h-36">
          <img
            src="IEL Assets/partners/logo_4.png"
            alt="Partner 4"
            loading="lazy"
            class="object-contain h-full w-full"
          />
        </div>

        <div class="w-36 h-36">
          <img
            src="IEL Assets/partners/logo_5.png"
            alt="Partner 5"
            class="object-contain h-full w-full"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- ---------------------------Ready to take the next step?---------- -->
    <div class="bg-[#F9F9F9] px-[16px] md:px-[7vw] py-[24px] md:py-[40px]">
      <div
        class="w-full max-w-[1400px] mx-auto flex flex-col md:flex-row justify-center text-center md:text-start md:justify-between items-center"
      >
        <div class="w-full md:w-[620px]">
          <h2
            class="text-[#000000] text-[20px] md:text-[40px] font-[600] leading-[100%]"
          >
            Ready to take the next step?
          </h2>
          <p
            class="mt-[12px] text-[#6E6E6E] font-[500] text-[16px] md:text-[20px] leading-[100%] md:leading-[28px]"
          >
            Whether you want to start investing, get advisory support, or just
            pick our brains—we’re here for it.
          </p>
          <p
            class="mt-[32px] text-[#000000] font-[600] text-[16px] md:text-[20px] leading-[100%]"
          >
            Open your account or schedule a chat. Let’s get growing.
          </p>
          <div
            class="flex justify-center md:justify-start items-center mt-[20px]"
          >
            <a
              class="py-3 flex justify-center items-center rounded-[4px] bg-[#E3442D] text-white font-[600] text-[16px] w-[263px]"
              href="Contact.html"
            >
              Book a Free Consultation
            </a>
            <!-- <a
              class="bg-[#58BA83] text-white py-3 flex justify-center items-center rounded-[4px] font-[600] text-[16px] w-[263px] ms-[24px]"
              href=""
            >
              Book a Free Consultation
            </a> -->
          </div>
        </div>
        <div class="mt-[24px] md:mt-0">
          <img
            src="IEL Assets/Service_new_img.jpg"
            alt="Service image"
            class="w-[496px] h-[376px]"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!------------------------- Tab Section ------------------------->
     <div class="mt-[28px] md:mt-[100px] mx-[16px] md:mx-[7vw]">
      <h2
        class="font-[600] text-[28px] md:text-[40px] leading-[100%] md:leading-[64px] text-[#000000] text-center"
      >
        Open Your Account in Minutes
      </h2>
      <div
        class="text-[#00000080] font-[500] text-[16px] md:text-[20px] leading-[100%] text-center mt-[20px]"
      >
        Experience fast, secure, and seamless onboarding.
      </div>
      <div class="flex justify-center">
        <div class="flex mt-[48px]">
          <button
            id="core-team-tab"
            class="tab-button rounded-tl-[12px] rounded-bl-[12px] text-[15px] font-[600] px-[12px] md:px-[40px] py-[8px] md:py-[16px] active_tab"
          >
            Sahulat (Easy) Account
          </button>
          <button
            id="board-members-tab"
            class="tab-button account_button text-[15px] px-[12px] md:px-[40px] py-[8px] md:py-[16px] font-[600]"
          >
            Individual Account
          </button>
          <button
            id="corporate-tab"
            class="tab-button account_button rounded-tr-[12px] rounded-br-[12px] text-[15px] px-[12px] md:px-[40px] py-[8px] md:py-[16px] font-[600]"
          >
            Corporate Account
          </button>
        </div>
      </div>

      <!-- Core Team Content -->
      <div id="core-team-content" class="team-content mt-[60px]  2xl:mx-[5vw] 4xl:mx-[10vw]">
        <div class="hidden md:flex justify-start items-start">
          <img
            src="IEL Assets/top_of cards.png"
            alt="Top of Cards"
            class="w-[331px] h-[71px] ms-[132px]"
            loading="lazy"
          />
        </div>
        <div class="flex justify-between items-center overflow-x-scroll">
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_1.png"
              alt="Tab Icon 1"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 1
            </div>

            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Fill in Your Basics
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
              Complete our simple sign-up form with your basic information.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px] ms-[16px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_2.png"
              alt="Tab Icon 2"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 2
            </div>

            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Verify with OTP
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
              Enter the one-time password sent to your registered mobile number.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px] ms-[16px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_3.png"
              alt="Tab Icon 3"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 3
            </div>
            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Submit Your NIC
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
             Upload your National Identity Card for quick verification to get started.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px] ms-[16px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_4.png"
              alt="Tab Icon 4"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 4
            </div>
            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Receive Account Info
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
              Check your registered email for account credentials and next
              steps.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
        </div>
        <div class="hidden md:flex justify-end items-end">
          <img
            src="IEL Assets/bottom_of_cards.png"
            alt="Bottom of Cards"
            class="w-[331px] h-[71px] items-end me-[132px]"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Board Members Content (Hidden by default) -->
      <div
        id="board-members-content"
        class="team-content hidden mt-[60px]  2xl:mx-[5vw] 4xl:mx-[10vw]"
      >
        <div class="hidden md:flex justify-start items-start">
          <img
            src="IEL Assets/top_of cards.png"
            alt="Top of Cards"
            class="w-[331px] h-[71px] ms-[132px]"
            loading="lazy"
          />
        </div>
        <div class="flex justify-between items-center overflow-x-scroll">
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_1.png"
              alt="Tab icon 1"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 1
            </div>

            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Fill in Your Basics
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
              Complete our simple sign-up form with your basic information.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px] ms-[16px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_2.png"
              alt="Tab icon 2"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 2
            </div>

            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Verify with OTP
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
              Enter the one-time password sent to your registered mobile number.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px] ms-[16px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_3.png"
              alt="Tab icon 3"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 3
            </div>
            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Submit Your Details
            </div>
            <p class="mt-[4px] font-[500] text-[20px] leading-[100%]">
              Upload your ID and documents to complete verification.
            </p>
            <hr class="mt-[32px] border-[#EA5B29] border-1" />
          </div>
          <div
            class="bg-[#ffffff] border border-[#D8D9D880] py-[20px] px-[18px] rounded-[8px] h-[276px] min-w-[281px] md:max-w-[281px] ms-[16px]"
            style="box-shadow: 0px 8px 16px 0px #0000000f"
          >
            <img
              src="IEL Assets/tab_icon_4.png"
              alt="Tab icon 4"
              class="w-[40px] h-[40px]"
              loading="lazy"
            />
            <div
              class="text-[#00000066] mt-[24px] font-[800] text-[14px] leading-[100%]"
            >
              STEP 4
            </div>
            <div
              class="text-[#6E6E6E] font-[500] text-[20px] leading-[28px] mt-[16px]"
            >
              Receive Account Info
            </div>
