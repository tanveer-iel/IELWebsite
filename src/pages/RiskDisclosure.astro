    <!-- -----------------------------Content Section------ -->
    <div class="mt-[28px] md:mt-[48px] mx-[16px] md:mx-[7vw]">
      <div
        class="grid grid-cols-1 lg:grid-cols-4 w-full max-w-[1400px] mx-auto"
      >
        <div
          class="p-[16px] md:p-[24px] lg:col-span-1 h-[320px]"
          style="
            box-shadow: 0px 0px 4px -1px #0000000f;
            box-shadow: 0px 0px 8px 0px #0000001a;
          "
        >
          <a href="Fraud.html">
            <button
              class="text-[#4B5563] font-[400] text-[16px] leading-[24px] bg-[#F9FAFB] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Fraud Warnings
            </button>
          </a>
          <a href="Privacy.html">
            <button
              class="text-[#4B5563] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Privacy Policy
            </button>
          </a>
          <a href="Terms.html">
            <button
              class="text-[#4B5563] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Terms & Conditions
            </button>
          </a>
          <a href="RiskDisclosure.html">
            <button
              class="text-[#E3442D] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
