---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <Fragment slot="head">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IEL | Fraud Warning</title>
    <meta
      name="description"
      content="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
    />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Fraud Warning | Integrated Equities Limited (IEL)"
    />
    <meta
      property="og:description"
      content="Fraud warning and risk disclosure from IEL: how to identify fraudulent schemes, verify official communications, and protect yourself when trading."
    />
    <meta property="og:url" content="https://iel.net.pk/Fraud.html" />
    <meta
      property="og:image"
      content="https://iel.net.pk/Assets/whiteLogoSvg.svg"
    />
    <meta property="og:site_name" content="Integrated Equities Limited" />
    <link rel="canonical" href="https://iel.net.pk/Fraud.html" />

    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="Assets/finalNavbar/navbar.css" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <style is:inline>
      #typed-text span {
        display: block;
      }
      .footer {
        /* Matches the height of the first div to create overlap */
        background: linear-gradient(180deg, #0f0d17 0%, #191535 100%);
      }
      .bg-overlay {
        position: relative;
        z-index: 10;
        top: -150px;
      }
    </style>
  
  </Fragment>

    <!-------------------------Hero Section------------------------->
    <div>
      <main class="h-[80px] xl:h-[110px]">
        <div class="content h-[80px] xl:h-[110px]">
          <div class="relative w-[100vw] h-[80px] xl:h-[110px]">
            <div class="container mx-auto">
              <!-- <div
                class="absolute top-0 left-0 w-full h-full object-cover hidden xl:block"
                style="
                  background: linear-gradient(
                    93.15deg,
                    #0e0c15 0%,
                    #1a1538 100%
                  );
                "
              ></div> -->
              <div
                class="absolute top-0 left-0 w-full h-full object-cover bg-[#F9F9F9] block xl:hidden"
              ></div>
            </div>
          </div>
        </div>

        <div class="menu h-[80px] pt-[10px] bg-white">
          <Nav />
        </div>
      </main>
    </div>

    <!-- -----------------------------Content Section------ -->
    <div class="mt-[28px] md:mt-[48px] mx-[16px] md:mx-[7vw]">
      <div
        class="grid grid-cols-1 lg:grid-cols-4 w-full max-w-[1400px] mx-auto"
      >
        <div
          class="p-[16px] md:p-[24px] lg:col-span-1 h-[320px]"
          style="
            box-shadow: 0px 0px 4px -1px #0000000f;
            box-shadow: 0px 0px 8px 0px #0000001a;
          "
        >
          <a href="Fraud.html">
            <button
              class="text-[#E3442D] font-[400] text-[16px] leading-[24px] bg-[#F9FAFB] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Fraud Warnings
            </button>
          </a>
          <a href="Privacy.html">
            <button
              class="text-[#4B5563] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Privacy Policy
            </button>
          </a>
          <a href="Terms.html">
            <button
              class="text-[#4B5563] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Terms & Conditions
            </button>
          </a>
          <a href="RiskDisclosure.html">
            <button
              class="text-[#4B5563] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
            >
              Risk Disclosure
            </button>
          </a>
          <!-- <button
            class="text-[#4B5563] font-[400] text-[16px] leading-[24px] rounded-[6px] w-full py-[12px] px-[24px] text-start"
          >
            Intellectual Property Rights
          </button> -->
        </div>
        <div class="lg:col-span-3 mt-[64px] lg:mt-0 lg:ps-[40px]">
          <h1 class="text-[#161E2E] font-[400] text-[32px] leading-[40px]">
            Fraud Warning
          </h1>

          <!-- <div class="bg-[#FDEFEA] py-[24px] px-[32px] mt-[24px]">
            <p
              class="text-[#E3442D] font-[700] text-[16px] leading-[28px] pb-[24px]"
            >
              If you receive any suspicious messages or identify any suspicious
              websites that purport to <br />
              be related to IEL, please email: [email] <br />
              Or contact our Customer services on the official phone number to
              confirm your <br />
              engagement with IEL.
            </p>
          </div> -->

          <div class="mt-[48px]">
            <h3 class="text-[#161E2E] font-[400] text-[24px] leading-[32px]">
              Warnings
            </h3>

            <p
              class="font-[400] text-[16px] leading-[24px] text-[#6B7280] mt-[8px]"
            >
              This Risk Disclosure document is prescribed by the Pakistan Stock
              Exchange Limited (PSX) under Clause 13(1) of the SecuritiesBroker
              (Licensing and Operations) Regulations, 2016. <br />
              <br />
              This document contains important information relating to various
              types of risks associated with trading and investment in financial
              products (equity securities, fixed income instruments, derivatives
              contracts etc.) being traded at PSX. The customer should carefully
              read this document before opening trading account with a broker.
              <br />
              <br />
              In case a customer suffers negative consequences or losses as a
              result of trading/investment, he/she shall be solely responsible
              for the same and PSX or Securities and Exchange Commission of
              Pakistan (SECP) shall not be held responsible/liable, in any
              manner whatsoever, for such negative consequences or losses.
              <br />
              <br />
              The customers must acknowledge and accept that there can be no
              guaranteed profit or guaranteed return on their invested capital
              and under no circumstances broker can provide customers such
              guarantee or fixed return on their investment in view of the fact
              that the prices of securities and futures contract can fall as
              well as rise depending on the market conditions and performance of
              the companies. Customers must understand that past performance is
              not a guide to future performance of the securities, contracts or
              market as a whole. In case the customers have any doubt or are
              unclear as to the risks/information disclosed in this document,
              PSX strongly recommends that such customer should seek an
              independent legal or financial advice in advance. <br />
              <br />

              PSX neither singly or jointly and expressly nor impliedly
              guarantee nor make any representation concerning the completeness,
              accuracy and adequacy of the information contained in this
              document as this document discloses the risks and other
              significant aspects of trading / investment at the minimum level.
              PSX does not provide or purport to provide any advice and shall
              not be liable to any person who enters into a business
              relationship with a broker based on any information contained in
              this document. Any information contained in this document must not
              be construed as business/investment advice in any manner
              whatsoever.
              <br />
              <br />
            </p>

            <h3 class="text-[#161E2E] font-[400] text-[24px] leading-[32px]">
              THE CUSTOMERS MUST BE AWARE OF AND ACQUAINTED WITH THE FOLLOWING:
            </h3>
            <h3 class="text-[#161E2E] font-[400] text-[24px] leading-[32px]">
              1. BASIC RISKS INVOLVED IN TRADING IN SECURITIES MARKET:
            </h3>
          </div>
        </div>
      </div>
    </div>
    <!-------------------------Footer---------------------->

    <Footer extra="mt-[80px]" />
<script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/slick-carousel/slick/slick.min.js"></script>

    <script is:inline src="index.js"></script>
  
</Layout>
