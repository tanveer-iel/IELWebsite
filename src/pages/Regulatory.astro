---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <Fragment slot="head">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IEL | Regulatory Information</title>
    <meta
      name="description"
      content="Smart moves. Sharp insights. Financial freedom—your way.
From your first stock pick to your next big acquisition—we're in it with you. IEL brings bespoke brokerage, laser-focused advisory, and strategy consulting under one roof"
    />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Regulatory Information | Integrated Equities Limited (IEL)"
    />
    <meta
      property="og:description"
      content="Corporate governance, board composition, regulatory status, and shareholding information for Integrated Equities Limited (IEL)."
    />
    <meta property="og:url" content="https://iel.net.pk/Regulatory.html" />
    <meta
      property="og:image"
      content="https://iel.net.pk/Assets/whiteLogoSvg.svg"
    />
    <meta property="og:site_name" content="Integrated Equities Limited" />
    <link rel="canonical" href="https://iel.net.pk/Regulatory.html" />

    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="Assets/finalNavbar/navbar.css" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <style is:inline>
      #typed-text span {
        display: block;
      }
      .footer {
        /* Matches the height of the first div to create overlap */
        background: linear-gradient(180deg, #0f0d17 0%, #191535 100%);
      }
      .bg-overlay {
        position: relative;
        z-index: 10;
        top: -150px;
      }

      .custom-clip {
        clip-path: polygon(
          25% 27.75%,
          43% 27.75%,
          63.14% 27.75%,
          75% 43.17%,
          75% 75%,
          25% 75%
        );
      }
    </style>
  
  </Fragment>

    <!-------------------------Hero Section------------------------->
    <div>
      <main class="h-[338px] xl:h-[338px]">
        <div class="content h-[338px] xl:h-[338px]">
          <div class="relative w-[100vw] h-[338px]">
            <div class="container mx-auto">
              <div
                class="absolute top-0 left-0 w-full h-full object-cover hidden xl:block"
                style="
                  background: linear-gradient(
                    93.15deg,
                    #0e0c15 0%,
                    #1a1538 100%
                  );
                "
              ></div>
              <div
                class="absolute top-0 left-0 w-full h-full object-cover bg-[#F9F9F9] block xl:hidden"
              ></div>
              <div
                class="relative flex flex-col-reverse xl:flex-row py-[40px] xl:py-[60px] px-[24px] xl:px-[42px] lg:px-16 justify-center md:justify-between item-center mt-[10vh] md:mt-[10vh] 3xl:mt-[10vh]"
              >
                <div
                  class="relative text-center xl:text-start text-black xl:text-white w-full flex flex-col justify-center items-center"
                  style="z-index: 105"
                >
                  <h1
                    id="typed-text"
                    class="font-[600] text-[28px] xl:text-[40px] xl:text-[40px] 2xl:text-[40px] leading-[100%] mt-[20px]"
                  >
                    Regulatory Information
                  </h1>
             
                </div>
                <img
                  src="IEL Assets/new_header_pattern.png"
                  alt="Header Pattern"
                  class="h-[200px] w-[580px] absolute -right-[100px] hidden xl:block"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="menu h-[80px] pt-[10px] bg-white">
          <Nav />
        </div>
      </main>
    </div>

    <!-- --------------------------Corporate Information---------------- -->
    <div class="mt-[28px] md:mt-[80px] mx-[16px] md:mx-[7vw]">
      <div class="w-full max-w-[1400px] mx-auto">
        <h2
          class="text-[20px] md:text-[40px] font-[600] leading-[100%] text-black text-center"
        >
          Corporate Information
        </h2>
        <div
