            <div
              class="col-span-2 md:col-span-2 lg:col-span-2 pt-4 px-4 md:px-10"
            >
              <div class="flex">
                <img
                  src="IEL Assets/partners/whiteLogoSvg.svg"
                  alt="IEL Logo"
                  class="w-[65px] md:w-[145px] h-[40px] md:h-[70px]"
                  loading="lazy"
                />
              </div>
            </div>
            <div
              class="ps-4 md:ps-10 text-[#535862] font-semibold mt-[24px] md:mt-0"
            >
              <p
                class="text-[14px] font-[900] mt-[16px] leading-[20px] text-[#FFFFFF]"
              >
                Main Navigation
              </p>
              <ul class="text-[16px] font-[500] mt-[16px] leading-loose">
                <li><a href="index.html">Home</a></li>
