---
const { extra = "mt-[80px]", padTop = "pt-[60px] md:pt-[100px]" } = Astro.props;
---
<div class={`footer ${extra}`}>
      <div class="rounded-b-2xl mx-2 bg-transparent">
        <div class="container mx-auto">
          <div
            class={`grid grid-cols-2 md:grid-cols-5 lg:grid-cols-5 mx-10 gap-4 ${padTop} pb-[64px] justify-between`}
          >
            <div
              class="col-span-2 md:col-span-2 lg:col-span-2 pt-4 px-4 md:px-10"
            >
              <div class="flex flex-wrap items-center gap-6">
                <img
                  src="Assets/IELTezi-logo-trimmed.webp"
                  alt="IEL Logo"
                  class="w-auto h-[60px] md:h-[90px] bg-white p-2 rounded-lg"
                  loading="lazy"
                />
                <button
                  type="button"
                  id="complaint-procedure-btn"
                  class="text-[16px] font-[600] text-[#FFFFFF] border border-[#535862] hover:border-white rounded-lg px-4 py-2 text-left"
                >
                  Procedure for Complaint Handling
                </button>
              </div>
            </div>
            <div
              class="ps-4 md:ps-10 text-[#535862] font-semibold mt-[24px] md:mt-0"
            >
              <p
                class="text-[14px] font-[900] mt-[16px] leading-[20px] text-[#FFFFFF]"
              >
                Main Navigation
              </p>
              <ul class="text-[16px] font-[500] mt-[16px] leading-loose">
                <li><a href="index.html">Home</a></li>
                <li><a href="About.html">About IEL</a></li>
                <li><a href="OpenAccount.html">Open Account</a></li>
                <li><a href="OpenAccount.html#Faqs">FAQs</a></li>
                <li><a href="Contact.html">Contact Us</a></li>
              </ul>
            </div>
            <div
              class="ps-4 md:ps-10 text-[#535862] font-semibold mt-[24px] md:mt-0"
            >
              <p
                class="text-[14px] font-[900] mt-[16px] leading-[20px] text-[#ffffff]"
              >
                Useful Links
              </p>
              <ul class="text-[16px] font-[500] mt-[16px] leading-loose">
                <li><a href="Regulatory.html">Regulatory Information</a></li>
                <li>
                  <a href="About.html#Associated_Company"
                    >Associated Companies</a
                  >
                </li>
                <li><a href="Resources.html#related_forms">Downloads</a></li>
                <li><a href="NewReport.html">Reports & Statements</a></li>
                <li><a href="">Investor Complaints</a></li>
                <li>
                  <a
                    href="https://www.psx.com.pk/psx/resources-and-tools/investors/investors-complaints"
                    target="_blank"
                    >PSX Complaint Mgmnt</a
                  >
                </li>
                <li>
                  <a href="https://sdms.secp.gov.pk/" target="_blank"
                    >SECP Complaint Mgmnt</a
                  >
                </li>
                <li><a href="Privacy.html">Privacy Policy</a></li>
              </ul>
            </div>
            <div
              class="ps-4 md:ps-10 text-[#535862] font-semibold mt-[24px] md:mt-0"
            >
              <p
                class="text-[14px] font-[900] mt-[16px] leading-[20px] text-[#ffffff]"
              >
                Contact
              </p>
              <ul class="text-[16px] font-[500] mt-[16px] leading-loose">
                <li><a href="">+92-4235741714-15</a></li>
                <li><a href="">+92-4235692606</a></li>
                <li>
                  <a
                    href="https://mail.google.com/mail/?view=cm&fs=1&to=info@iel.net.pk"
                    target="_blank"
                    >info@iel.net.pk</a
                  >
                </li>
              </ul>
              <div class="leading-[130%]">
                <p class="text-[16px] font-[600] mt-[16px]">
                  30 Cricketers Colony, 3rd floor, NETSOL Avenue, Ghazi
                  Interchange, Ring Road, Lahore
                </p>
                <p class="text-[16px] font-[600] mt-[16px]">
                  Room# 134, 3rd Floor, KSE Building, Karachi
                </p>
              </div>
              <!-- <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d11216.406651584566!2d74.22943439199008!3d31.49303273478952!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391902686a66d6a1%3A0xd126df77dd9ca0d!2sThokar%20Niaz%20Baig%2C%20Lahore%2C%20Pakistan!5e1!3m2!1sen!2s!4v1749645230422!5m2!1sen!2s"
                width="180"
                height="160"
                style="border: 0"
                allowfullscreen=""
                loading="lazy"
                class="mt-10"
              ></iframe> -->
            </div>
          </div>
          <div class="mx-[7vw] text-center pb-10">
            <h3 class="text-[#FFFFFF]">
              Smart Stock System — Our Backoffice Software Vendor
            </h3>
            <p class="text-[#535862]">
              At our brokerage, we leverage the Smart Stock System as our
              trusted backoffice software solution. This system helps ensure
              efficient trade processing, seamless settlements, and accurate
              client account management, enabling us to deliver a secure and
              reliable trading experience for all our customers.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-white mx-7vw">
      <img src="IEL Assets/disclaimer.png" alt="Disclaimer" loading="lazy" />
    </div>
    <dialog
      id="complaint-procedure-dialog"
      class="rounded-xl p-0 w-[92vw] max-w-[900px] backdrop:bg-black/60"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 p-4 border-b border-gray-200">
        <h3 class="text-[18px] font-[700] text-[#0a0a1a]">
          Procedure for Complaint Handling
        </h3>
        <div class="flex flex-wrap items-center gap-2">
          <a
            href="docs/Procedure-for-Complaint-Handling-MUFAP.pdf"
            download="Procedure for Complaint Handling - MUFAP.pdf"
            class="bg-[#d34534] text-white text-[14px] font-[600] rounded-md px-4 py-2"
            >Download</a
          >
          <a
            href="docs/Procedure-for-Complaint-Handling-MUFAP.pdf"
            target="_blank"
            rel="noopener"
            class="border border-gray-300 text-[#0a0a1a] text-[14px] font-[600] rounded-md px-4 py-2"
            >View in Browser Tab</a
          >
          <button
            type="button"
            id="complaint-procedure-close"
            class="text-[#0a0a1a] text-[14px] font-[600] rounded-md px-3 py-2"
            aria-label="Close"
          >
            ✕
          </button>
        </div>
      </div>
      <iframe
        id="complaint-procedure-frame"
        title="Procedure for Complaint Handling"
        class="w-full h-[75vh] bg-white"
      ></iframe>
    </dialog>
    <script is:inline>
      (function () {
        var btn = document.getElementById("complaint-procedure-btn");
        var dlg = document.getElementById("complaint-procedure-dialog");
        var frame = document.getElementById("complaint-procedure-frame");
        var close = document.getElementById("complaint-procedure-close");
        if (!btn || !dlg) return;
        var src = "docs/Procedure-for-Complaint-Handling-MUFAP.pdf";
        btn.addEventListener("click", function () {
          if (!frame.getAttribute("src")) frame.setAttribute("src", src);
          dlg.showModal();
        });
        close.addEventListener("click", function () {
          dlg.close();
        });
        dlg.addEventListener("click", function (e) {
          if (e.target === dlg) dlg.close();
        });
      })();
    </script>
